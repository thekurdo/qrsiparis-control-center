{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v1/applications/[^/]+",
    "headers": {
      "X-Mock-Mode": { "equalTo": "health-fail" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "uuid": "{{request.pathSegments.[3]}}",
      "name": "test-app",
      "domain": "test.local",
      "status": "failed"
    },
    "transformers": ["response-template"]
  }
}
