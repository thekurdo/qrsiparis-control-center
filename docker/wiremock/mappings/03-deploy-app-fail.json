{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/v1/applications/[^/]+/deploy",
    "headers": {
      "X-Mock-Mode": { "equalTo": "deploy-fail" }
    }
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": "Mock: deploy intentionally failed",
      "code": "DEPLOY_FAILED"
    }
  }
}
