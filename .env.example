# QrSiparis Control Center — environment variables (template).
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ---- Runtime ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ---- PostgreSQL (control-center DB) ----
DATABASE_URL=postgres://user:pass@localhost:5432/qrsiparis_cc

# ---- Redis (BullMQ + SSE pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- Auth.js v5 ----
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# ---- Master encryption key (AES-256-GCM) ----
# 32-byte hex (64 chars). Used to encrypt:
#   servers.coolifyApiToken, servers.sshPrivateKey, operatorUsers.twoFactorSecret
# Generate with: openssl rand -hex 32
MASTER_KEY=

# ---- SSH (encrypted blob; decrypted only at SSH connection time) ----
SSH_PRIVATE_KEY_ENCRYPTED=

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---- Default operator user (created on first migration/seed) ----
DEFAULT_OPERATOR_USER=admin
DEFAULT_OPERATOR_EMAIL=

# ---- Build-time metadata (populated by docker-build.yml) ----
APP_VERSION=dev
GIT_COMMIT=unknown
